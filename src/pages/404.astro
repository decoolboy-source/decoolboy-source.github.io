---
import Base from '../layouts/Base.astro';
import { TOOLS } from '../data/tools';
---
<Base title="Không tìm thấy trang" description="Trang không tồn tại.">
  <header class="page-head">
    <p class="eyebrow">Lỗi 404</p>
    <h1>Không tìm thấy trang</h1>
    <p class="lead">Đường dẫn có thể đã đổi hoặc gõ sai. Lưu ý: đường dẫn công cụ phân biệt chữ hoa, chữ thường.</p>
  </header>
  <div class="actions" style="margin-top:0">
    <a class="btn primary" href="/">Về trang chủ</a>
    <a class="btn" href="/cong-cu/">Danh sách công cụ</a>
  </div>
  <h2>Công cụ</h2>
  <ul>
    {TOOLS.map((t) => <li><a href={`/${t.repo}/`}>{t.name}</a> – <code>/{t.repo}/</code></li>)}
  </ul>
</Base>
