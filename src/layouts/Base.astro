---
import '../styles/global.css';
import { SITE, NAV } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
}

const { title, description = SITE.description, article = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/fonts/bvp-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bvp-latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0a2540" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} – Kỹ sư lạnh công nghiệp`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {article && <div class="read-progress" aria-hidden="true"></div>}
    <a class="skip" href="#noi-dung">Bỏ qua điều hướng</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">QĐ</span>
          <span class="brand-text">{SITE.name}</span>
        </a>
        <nav aria-label="Điều hướng chính">
          <ul class="nav">
            {NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="noi-dung" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">QĐ</span>
            <span class="brand-text">{SITE.name}</span>
          </a>
          <p>Kỹ sư lạnh công nghiệp · Kho lạnh – Cấp đông · HVAC · MEP · BIM</p>
        </div>
        <nav aria-label="Nội dung">
          <h2>Nội dung</h2>
          <ul>
            {NAV.slice(0, 5).map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
        <nav aria-label="Thông tin">
          <h2>Thông tin</h2>
          <ul>
            <li><a href="/lien-he/">Liên hệ</a></li>
            <li><a href="/namecard/">Namecard điện tử</a></li>
            <li><a href="/chinh-sach/">Miễn trừ &amp; quyền riêng tư</a></li>
          </ul>
        </nav>
      </div>
      <div class="wrap footer-bottom">
        <p>© {new Date().getFullYear()} {SITE.name}. Nội dung tự viết; số liệu dự án đã làm tròn. Website không dùng cookie.</p>
      </div>
    </footer>
  </body>
</html>
